{
  "opencollection": "1.0.0",
  "info": {
    "name": "JarvisLabs Account Templates API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Templates",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List templates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.jarvislabs.ai/v1/templates"
          },
          "docs": "Lists available framework templates used to provision instances. Equivalent to User.get_templates() and `jl templates`."
        }
      ]
    }
  ],
  "bundled": true
}